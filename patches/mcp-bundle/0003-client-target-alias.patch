symfony/mcp-bundle: make #[Target('<client>')] resolve

The documentation shows `#[Target('research')] McpClientInterface $client`, but
the bundle only registered the alias for the argument name `$researchClient`, so
that example failed at compile time with "no such target exists".

Registers both spellings.

diff --git a/src/mcp-bundle/src/McpBundle.php b/src/mcp-bundle/src/McpBundle.php
index 6b8f9e68..c9a55df4 100644
--- a/src/mcp-bundle/src/McpBundle.php
+++ b/src/mcp-bundle/src/McpBundle.php
@@ -167,7 +181,9 @@ final class McpBundle extends AbstractBundle
                 ->setArguments([$clientName, new Reference($locatorId)])
                 ->addTag('mcp.client', ['name' => $clientName]);
 
+            // Both spellings; the documentation shows #[Target('research')].
             $container->registerAliasForArgument('mcp.client.'.$clientName, McpClientInterface::class, $clientName.' client');
+            $container->registerAliasForArgument('mcp.client.'.$clientName, McpClientInterface::class, $clientName);
 
             $clientReferences[$clientName] = new Reference('mcp.client.'.$clientName);
         }
