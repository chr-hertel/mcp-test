@@ -829,4 +836,33 @@ final class McpBundle extends AbstractBundle
 
         return $id;
     }
+
+    /**
+     * @param array{store: string, directory: string|null, cache_pool: string, prefix: string|null, ttl: int, lock: array{enabled: bool, factory: string|null, timeout: float}} $session
+     */
+    private function configureSessionLock(string $name, array $session, ContainerBuilder $container): string
+    {
+        $id = \sprintf('mcp.server.%s.session.lock', $name);
+
+        if (null !== $session['lock']['factory']) {
+            $container->register($id, SymfonyLockSessionLock::class)
+                ->setArguments([
+                    new Reference($session['lock']['factory']),
+                    $session['lock']['timeout'],
+                    '$prefix' => \sprintf('mcp-%s-session-', $name),
+                ]);
+
+            return $id;
+        }
+
+        $container->register($id, FileSessionLock::class)
+            ->setArguments([
+                $session['directory'] ?? '%kernel.cache_dir%/mcp-sessions/'.$name,
+                $session['lock']['timeout'],
+                new Reference('logger'),
+            ])
+            ->addTag('monolog.logger', ['channel' => 'mcp']);
+
+        return $id;
+    }
 }
