From 519d51800787c6c596a1d6de5122df4d3af46875 Mon Sep 17 00:00:00 2001
From: Christopher Hertel <mail@christopher-hertel.de>
Date: Tue, 13 Oct 2026 02:36:09 +0200
Subject: [PATCH] [MCP Bundle] Expose the server capabilities on
 `ServerConnectionInterface`

mcp/sdk 0.9 adds `Client::getServerCapabilities()`, returning what the server
declared in `initialize` or, on 2026-07-28, in `server/discover`
(modelcontextprotocol/php-sdk#542). The connection already forwards the other
three things the server declares about itself - info, protocol version and
instructions - so this completes the set.
---
 src/mcp-bundle/CHANGELOG.md                      |  1 +
 src/mcp-bundle/src/Client/ServerConnection.php   |  8 ++++++++
 .../src/Client/ServerConnectionInterface.php     |  6 ++++++
 .../tests/Client/ServerConnectionTest.php        | 16 ++++++++++++++++
 4 files changed, 31 insertions(+)

diff --git a/src/mcp-bundle/CHANGELOG.md b/src/mcp-bundle/CHANGELOG.md
index adeca3a2..69267712 100644
--- a/src/mcp-bundle/CHANGELOG.md
+++ b/src/mcp-bundle/CHANGELOG.md
@@ -30,6 +30,7 @@ CHANGELOG
  * Add the `clients.<name>.roots` option pointing at a `RootsCallbackInterface` service, replacing the
    `capabilities.roots` flag, and add `getProtocolVersion()` and `sendRootsListChanged()` on
    `ServerConnectionInterface`
+ * Add `getServerCapabilities()` on `ServerConnectionInterface`, returning what the remote server declared
 
 0.12
 ----
diff --git a/src/mcp-bundle/src/Client/ServerConnection.php b/src/mcp-bundle/src/Client/ServerConnection.php
index 2bd73164..3812fb8d 100644
--- a/src/mcp-bundle/src/Client/ServerConnection.php
+++ b/src/mcp-bundle/src/Client/ServerConnection.php
@@ -27,6 +27,7 @@ use Mcp\Schema\Result\ListResourcesResult;
 use Mcp\Schema\Result\ListResourceTemplatesResult;
 use Mcp\Schema\Result\ListToolsResult;
 use Mcp\Schema\Result\ReadResourceResult;
+use Mcp\Schema\ServerCapabilities;
 use Symfony\AI\McpBundle\Exception\ConnectionException;
 use Symfony\AI\McpBundle\Exception\ExceptionInterface;
 use Symfony\AI\McpBundle\Exception\RemoteCallException;
@@ -124,6 +125,13 @@ final class ServerConnection implements ServerConnectionInterface, ResetInterfac
         return $this->client->getInstructions();
     }
 
+    public function getServerCapabilities(): ?ServerCapabilities
+    {
+        $this->connect();
+
+        return $this->client->getServerCapabilities();
+    }
+
     public function ping(): void
     {
         $this->call('ping', fn () => $this->client->ping());
diff --git a/src/mcp-bundle/src/Client/ServerConnectionInterface.php b/src/mcp-bundle/src/Client/ServerConnectionInterface.php
index bed4ee8d..bf6e6b8b 100644
--- a/src/mcp-bundle/src/Client/ServerConnectionInterface.php
+++ b/src/mcp-bundle/src/Client/ServerConnectionInterface.php
@@ -27,6 +27,7 @@ use Mcp\Schema\Result\ListResourcesResult;
 use Mcp\Schema\Result\ListResourceTemplatesResult;
 use Mcp\Schema\Result\ListToolsResult;
 use Mcp\Schema\Result\ReadResourceResult;
+use Mcp\Schema\ServerCapabilities;
 use Mcp\Schema\Tool;
 
 /**
@@ -65,6 +66,11 @@ interface ServerConnectionInterface
 
     public function getInstructions(): ?string;
 
+    /**
+     * What the server declared it supports, from `initialize` or, on 2026-07-28, from `server/discover`.
+     */
+    public function getServerCapabilities(): ?ServerCapabilities;
+
     public function ping(): void;
 
     public function listTools(?string $cursor = null): ListToolsResult;
diff --git a/src/mcp-bundle/tests/Client/ServerConnectionTest.php b/src/mcp-bundle/tests/Client/ServerConnectionTest.php
index 8f523f63..1ad43d8e 100644
--- a/src/mcp-bundle/tests/Client/ServerConnectionTest.php
+++ b/src/mcp-bundle/tests/Client/ServerConnectionTest.php
@@ -184,6 +184,22 @@ final class ServerConnectionTest extends TestCase
         $this->assertSame(ProtocolVersion::V2025_11_25, $connection->getProtocolVersion());
     }
 
+    public function testServerCapabilitiesComeFromTheHandshake()
+    {
+        $connection = $this->createConnection(new InMemoryTransport(['initialize' => [[
+            'protocolVersion' => '2025-11-25',
+            'capabilities' => ['tools' => ['listChanged' => true], 'completions' => []],
+            'serverInfo' => ['name' => 'test-server', 'version' => '1.0.0'],
+        ]]]));
+
+        $capabilities = $connection->getServerCapabilities();
+
+        $this->assertNotNull($capabilities);
+        $this->assertTrue($capabilities->toolsListChanged);
+        $this->assertTrue($capabilities->completions);
+        $this->assertFalse($capabilities->prompts);
+    }
+
     public function testRootsListChangedIsSentAsANotification()
     {
         $transport = new InMemoryTransport();
