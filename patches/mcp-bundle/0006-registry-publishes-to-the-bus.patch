symfony/mcp-bundle: publish the registry's changes to the configured bus

`subscriptions:` configures a notification bus, and the 2026-07-28 protocol
reads it: every `subscriptions/listen` stream polls it for the list-changed
notifications it agreed to carry. Nothing ever wrote to it.

The SDK's `Builder` wires the publishing half itself — it wraps the event
dispatcher in a `PublishingEventDispatcher` when a bus is configured — but only
around a registry it constructs. A registry supplied through `setRegistry()` is
already built, so the wrapping cannot reach it, and this bundle always supplies
one. So the bus was read by every stream and written to by nothing: a stream
opened, acknowledged the filter it agreed to, held for its lifetime and closed,
having carried nothing at all, no matter what changed on the server.

Gives the registry the publishing dispatcher at the point it is registered,
which is the only place the bundle knows both the bus and the registry. Per
server rather than one publisher on the shared `event_dispatcher`, because the
registries are per server too: a tool appearing on one of them is not news to a
client subscribed to another.

diff --git a/src/mcp-bundle/src/McpBundle.php b/src/mcp-bundle/src/McpBundle.php
index 6b8f9e68..c9a55df4 100644
--- a/src/mcp-bundle/src/McpBundle.php
+++ b/src/mcp-bundle/src/McpBundle.php
@@ -338,13 +360,13 @@ final class McpBundle extends AbstractBundle
     {
         $registryId = \sprintf('mcp.server.%s.registry', $name);
         $builderId = \sprintf('mcp.server.%s.builder', $name);
         // 2026-07-28 removed sessions, so a stateless server needs no store.
         $sessionId = 'stateless' === $server['lifecycle']
             ? null
             : $this->configureSessionStore($name, $server['session'], $container);
 
         $container->register($registryId, Registry::class)
-            ->setArguments([new Reference('event_dispatcher'), new Reference('logger')])
+            ->setArguments([$this->registryDispatcher($name, $server), new Reference('logger')])
             ->addTag('monolog.logger', ['channel' => 'mcp']);
 
         $container->register($builderId, Builder::class)
@@ -589,6 +721,36 @@ final class McpBundle extends AbstractBundle
         }
     }
 
+    /**
+     * The dispatcher a server's registry announces its changes to.
+     *
+     * The SDK wraps the dispatcher in a {@see PublishingEventDispatcher} when a
+     * notification bus is configured — but only around a registry it builds
+     * itself, and this bundle always supplies one, so that wrapping never
+     * happens here. Without this, `subscriptions:` would configure a bus that
+     * every `subscriptions/listen` stream reads and nothing ever writes to.
+     *
+     * Per server rather than one publisher on the shared dispatcher, because
+     * the registries are per server too: a tool appearing on one of them is not
+     * news to a client subscribed to another.
+     *
+     * @param array<string, mixed> $server
+     */
+    private function registryDispatcher(string $name, array $server): Reference|Definition
+    {
+        if ('none' === $server['subscriptions']['bus']) {
+            return new Reference('event_dispatcher');
+        }
+
+        // By id rather than through notificationBus(): the registry is defined
+        // before the call that registers the bus, and a forward reference is
+        // resolved at compile time like any other.
+        return new Definition(PublishingEventDispatcher::class, [
+            new Reference(\sprintf('mcp.server.%s.notification_bus', $name)),
+            new Reference('event_dispatcher'),
+        ]);
+    }
+
     /**
      * @param array{store: string, directory: string|null, cache_pool: string, prefix: string|null, ttl: int} $session
      */

diff --git a/src/mcp-bundle/tests/DependencyInjection/McpBundleSubscriptionsTest.php b/src/mcp-bundle/tests/DependencyInjection/McpBundleSubscriptionsTest.php
new file mode 100644
index 00000000..25e2fa14
--- /dev/null
+++ b/src/mcp-bundle/tests/DependencyInjection/McpBundleSubscriptionsTest.php
@@ -0,0 +1,107 @@
+<?php
+
+/*
