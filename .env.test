# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The chat host answers with the scripted stand-in here, whatever .env.local says:
# the suite drives a real turn through the agent, and it must neither need an
# account nor reach the network. See docs/chat.md.
MCP_DEMO_CHAT_PLATFORM=scripted
MCP_DEMO_CHAT_MODEL=scripted-host-1
