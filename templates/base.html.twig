<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MCP Demo{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><rect width=%2216%22 height=%2216%22 rx=%223%22 fill=%22%23009b83%22/></svg>">
    <style>
        :root {
            color-scheme: light dark;
            --bg: #fbfbfc;
            --panel: #ffffff;
            --fg: #14161a;
            --muted: #5c6470;
            --line: #e3e6ea;
            --accent: #009b83;
            --accent-soft: #e6f5f2;
            --warn: #b45309;
            --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #0f1114;
                --panel: #16191d;
                --fg: #eceef1;
                --muted: #99a1ad;
                --line: #262a30;
                --accent: #2fd4b5;
                --accent-soft: #122b27;
                --warn: #f59e0b;
            }
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--fg);
            font: 15px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        .wrap { max-width: 1040px; margin: 0 auto; padding: 0 24px 72px; }

        header.site {
            border-bottom: 1px solid var(--line);
            background: var(--panel);
            margin-bottom: 32px;
        }
        header.site .wrap { padding-top: 18px; padding-bottom: 18px; display: flex; align-items: baseline; gap: 24px; flex-wrap: wrap; }
        header.site strong { font-size: 15px; letter-spacing: -0.01em; }
        header.site nav { display: flex; gap: 18px; margin-left: auto; }
        header.site nav a { color: var(--muted); text-decoration: none; font-size: 14px; }
        header.site nav a:hover, header.site nav a[aria-current] { color: var(--fg); }

        h1 { font-size: 26px; letter-spacing: -0.02em; margin: 0 0 6px; }
        h2 { font-size: 15px; letter-spacing: -0.01em; margin: 36px 0 12px; }
        h3 { font-size: 14px; margin: 0 0 8px; }
        p.lede { color: var(--muted); margin: 0 0 28px; max-width: 62ch; }

        a { color: var(--accent); }
        code, .mono { font-family: var(--mono); font-size: 0.88em; }

        .panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 18px 20px;
        }
        .grid { display: grid; gap: 14px; }
        .grid.cols-3 { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
        .grid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }

        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
        .stat { background: var(--panel); padding: 14px 16px; }
        .stat b { display: block; font-size: 24px; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
        .stat span { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; }

        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th { text-align: left; color: var(--muted); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; padding: 0 12px 8px 0; border-bottom: 1px solid var(--line); }
        td { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
        tr:last-child td { border-bottom: 0; }
        td.time { font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }

        .chip { display: inline-block; padding: 1px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: 11px; font-weight: 600; }
        .chip.plain { background: var(--line); color: var(--muted); font-weight: 500; }
        .chip.warn { background: transparent; color: var(--warn); border: 1px solid currentColor; }

        ul.plain { list-style: none; margin: 0; padding: 0; }
        ul.plain li { padding: 5px 0; border-bottom: 1px solid var(--line); }
        ul.plain li:last-child { border-bottom: 0; }

        .muted { color: var(--muted); }
        .scroll { overflow-x: auto; }
        details summary { cursor: pointer; color: var(--muted); font-size: 13px; }
        details[open] summary { margin-bottom: 10px; }
    </style>
    {# The asset mapper serves the chat's stylesheet and its Stimulus controllers;
       everything above is inline because it is the whole of the rest of the site. #}
    {% block javascripts %}{{ importmap('app') }}{% endblock %}
</head>
<body>
<header class="site">
    <div class="wrap">
        <strong>MCP Demo</strong>
        <span class="muted" style="font-size:13px">mcp/sdk &amp; symfony/mcp-bundle, end to end</span>
        <nav>
            <a href="{{ path('dashboard') }}"{{ app.request.attributes.get('_route') == 'dashboard' ? ' aria-current="page"' : '' }}>Overview</a>
            <a href="{{ path('schedule') }}"{{ app.request.attributes.get('_route') == 'schedule' ? ' aria-current="page"' : '' }}>Schedule</a>
            <a href="{{ path('speakers') }}"{{ app.request.attributes.get('_route') == 'speakers' ? ' aria-current="page"' : '' }}>Speakers</a>
            <a href="{{ path('chat') }}"{{ app.request.attributes.get('_route') starts with 'chat' ? ' aria-current="page"' : '' }}>Chat</a>
        </nav>
    </div>
</header>

<div class="wrap">
    {% block body %}{% endblock %}
</div>
</body>
</html>
