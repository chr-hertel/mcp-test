{
    "name": "chr-hertel/mcp-demo",
    "type": "project",
    "license": "MIT",
    "description": "A Symfony application demonstrating the MCP PHP SDK and symfony/mcp-bundle end to end: server, client, tools, prompts, resources, templates, completions, apps, sampling, elicitation, roots and a regression harness.",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/mcp-bundle",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/mcp-bundle": "0.1.99"
                }
            }
        },
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/platform",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/ai-platform": "0.13.99"
                }
            }
        },
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/platform/src/Bridge/Anthropic",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/ai-anthropic-platform": "0.13.99"
                }
            }
        },
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/platform/src/Bridge/OpenResponses",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/ai-open-responses-platform": "0.13.99"
                }
            }
        },
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/platform/src/Bridge/OpenAi",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/ai-open-ai-platform": "0.13.99"
                }
            }
        },
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/agent",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/ai-agent": "0.13.99"
                }
            }
        },
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/agent/src/Bridge/Mcp",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/ai-mcp-tool": "0.13.99"
                }
            }
        },
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/chat",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/ai-chat": "0.13.99"
                }
            }
        },
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/chat/src/Bridge/Session",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/ai-session-message-store": "0.13.99"
                }
            }
        },
        {
            "type": "path",
            "url": "upstream/symfony-ai/src/ai-bundle",
            "options": {
                "symlink": true,
                "versions": {
                    "symfony/ai-bundle": "0.13.99"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^3|^4",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "league/commonmark": "^2.7",
        "mcp/sdk": "dev-main as 0.8.99",
        "nyholm/psr7": "^1.8",
        "psr/simple-cache": "^3.0",
        "symfony/ai-agent": "0.13.99",
        "symfony/ai-anthropic-platform": "0.13.99",
        "symfony/ai-bundle": "0.13.99",
        "symfony/ai-chat": "0.13.99",
        "symfony/ai-mcp-tool": "0.13.99",
        "symfony/ai-open-ai-platform": "0.13.99",
        "symfony/ai-open-responses-platform": "0.13.99",
        "symfony/ai-platform": "0.13.99",
        "symfony/ai-session-message-store": "0.13.99",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mcp-bundle": "0.1.99",
        "symfony/monolog-bundle": "^3.10",
        "symfony/psr-http-message-bridge": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/ux-live-component": "^2.36",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^3.12",
        "twig/markdown-extra": "^3.12",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/process": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": false,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*"
        }
    }
}
